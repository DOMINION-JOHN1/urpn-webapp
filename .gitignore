# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache

# Testing
/coverage

# Next.js build output
/.next/
/out/

# Production
/build

# TypeScript / Next.js generated files
*.tsbuildinfo
next-env.d.ts

# Environment variables (contain secrets — never commit)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Secrets & credentials
# Default-deny ALL .json so a stray Google service-account key can never be
# committed. Add an explicit "!name.json" line for any safe config you DO
# want tracked (e.g. a future vercel.json).
*.json
!package.json
!package-lock.json
!tsconfig.json

# Local portal data (users, progress, attempts, session secret)
/data/
/.tmp-media/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Deployment
.vercel

# IDE / OS
.DS_Store
*.pem
.vscode
.idea

# Python cache
__pycache__/
*.pyc

# Supabase CLI local project metadata
/supabase/.temp/
