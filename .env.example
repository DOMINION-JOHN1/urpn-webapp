# ==============================================================================
# URPN Platform - Environment Variables Template
# Copy this file to .env.local for local development.
# In production, set these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Worker portal
# ------------------------------------------------------------------------------
# Signs session cookies. Use 32+ random characters in production:
#   openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-64-character-random-hex-string-before-deploying

# Where the app stores users, progress, attempts, and certificates.
# Defaults to ./data inside the project. On a server, point this at a
# persistent, writable volume. On serverless platforms with an ephemeral
# filesystem this data will not survive redeploys — see README.
# URPN_DATA_DIR=/var/lib/urpn

# Seed a demo worker (worker@urpn.org / urpn2026) on an empty database and show
# the demo credentials on the sign-in page. Set to false before going public.
SHOW_DEMO_LOGIN=true

# ------------------------------------------------------------------------------
# 0b. Production infrastructure (prepared, not wired yet)
# See docs/INFRASTRUCTURE.md. These are placeholders for the Supabase + Mux
# migration; the current app still uses the local JSON store and media folder.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Mux video (recommended)
# MUX_TOKEN_ID=your-mux-token-id
# MUX_TOKEN_SECRET=your-mux-token-secret
# MUX_SIGNING_KEY_ID=your-signing-key-id
# MUX_SIGNING_PRIVATE_KEY=your-signing-private-key

# ------------------------------------------------------------------------------
# 1. Google authentication — CHOOSE ONE method
# ------------------------------------------------------------------------------
#
# METHOD A (recommended for a free @gmail.com account): OAuth user delegation.
# Files are uploaded into YOUR OWN Google Drive, so there is no service-account
# storage-quota error. Set the three values below, then run:
#     node scripts/get-google-token.mjs
# to obtain GOOGLE_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token-from-the-helper-script

# METHOD B (only works with a Google Workspace Shared Drive): service account.
# Leave these blank if you are using Method A above.
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=testimony-bot@your-gcp-project-id.iam.gserviceaccount.com
# Paste the private key from your service account JSON key file (with \n newlines intact):
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. Google Drive Storage
# ID of the Google Drive folder where testimonies (audio/video) will be uploaded.
# (Share this folder with GOOGLE_SERVICE_ACCOUNT_EMAIL as 'Editor' or 'Content Manager').
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=1abcXYZ_your_google_drive_folder_id

# ------------------------------------------------------------------------------
# 3. Google Sheets Integration
# ID of the Google Spreadsheet used for tracking submissions & transcripts.
# (Share this spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as 'Editor').
# ------------------------------------------------------------------------------
GOOGLE_SHEET_ID=1abcXYZ_your_google_sheet_id
GOOGLE_SHEET_NAME=Submissions

# ------------------------------------------------------------------------------
# 4. Transcription Providers
# Primary: Deepgram API Key (high accuracy, fast, supports WebM/MP4 audio & video).
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 5. Recording & Upload Limits (Configurable)
# ------------------------------------------------------------------------------
# Maximum voice recording time in seconds (default: 600s = 10 minutes)
MAX_AUDIO_RECORDING_SECONDS=600

# Maximum video recording time in seconds (default: 420s = 7 minutes)
MAX_VIDEO_RECORDING_SECONDS=420

# Maximum allowed file upload size in Megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# Optional: CORS Allowed Origins (comma-separated, default: * in dev)
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app
