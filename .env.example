# ==============================================================================
# Church Testimony Platform - Environment Variables Template
# Copy this file to .env.local for local development.
# In production, set these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Service Account Credentials
# Required for storing media files in Google Drive and saving submissions to Google Sheets.
# ------------------------------------------------------------------------------
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=testimony-bot@your-gcp-project-id.iam.gserviceaccount.com
# Paste the private key from your service account JSON key file (with \n newlines intact):
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. Google Drive Storage
# ID of the Google Drive folder where testimonies (audio/video) will be uploaded.
# (Share this folder with GOOGLE_SERVICE_ACCOUNT_EMAIL as 'Editor' or 'Content Manager').
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=1abcXYZ_your_google_drive_folder_id

# ------------------------------------------------------------------------------
# 3. Google Sheets Integration
# ID of the Google Spreadsheet used for tracking submissions & transcripts.
# (Share this spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as 'Editor').
# ------------------------------------------------------------------------------
GOOGLE_SHEET_ID=1abcXYZ_your_google_sheet_id
GOOGLE_SHEET_NAME=Submissions

# ------------------------------------------------------------------------------
# 4. Transcription Providers
# Primary: Deepgram API Key (high accuracy, fast, supports WebM/MP4 audio & video).
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 5. Recording & Upload Limits (Configurable)
# ------------------------------------------------------------------------------
# Maximum voice recording time in seconds (default: 600s = 10 minutes)
MAX_AUDIO_RECORDING_SECONDS=600

# Maximum video recording time in seconds (default: 420s = 7 minutes)
MAX_VIDEO_RECORDING_SECONDS=420

# Maximum allowed file upload size in Megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# Optional: CORS Allowed Origins (comma-separated, default: * in dev)
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app
